---
import '../styles/global.css';
import SectionPager from '../components/SectionPager.astro';
import { meta } from '../lib/data';
import { dateIt } from '../lib/format';
import { sectionForPath, sectionNumber, SECTIONS } from '../lib/sections';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const SITE_NAME = 'Conto Europa';
const current = sectionForPath(Astro.url.pathname);
// La testata grande è la copertina: nelle pagine interne lascia spazio ai contenuti.
const isFront = current?.id === 'panoramica';
const updated = dateIt(meta.generatedAt);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} — ${SITE_NAME}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>

    <header class:list={['masthead wrap', { compact: !isFront }]}>
      <div class="strip kicker">
        <span>Fondi europei · dati aperti della Commissione</span>
        <span>Dati scaricati il {updated}</span>
      </div>
      <a class="nameplate display" href="/" data-keep-filters>Conto <em>Europa</em></a>
    </header>

    <nav class="sections" aria-label="Sezioni">
      <div class="wrap">
        <ol>
          {
            SECTIONS.map((s) => (
              <li>
                <a href={s.href} data-keep-filters aria-current={s.id === current?.id ? 'page' : undefined}>
                  <span class="num">{sectionNumber(s.id)}</span>
                  {s.label}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>

    <main id="contenuto" class="wrap">
      <slot />
      {current && <SectionPager section={current} />}
    </main>

    <footer class="wrap">
      <div class="double-rule foot">
        <p class="kicker">Fonti</p>
        <ul>
          {
            meta.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener">{s.name}</a>
                <span class="figure"> · riferimento {s.asOf}</span>
              </li>
            ))
          }
        </ul>
        <p class="small">
          Elaborazione indipendente su dati pubblici della Commissione europea. Non è un prodotto ufficiale dell’Unione.{' '}
          <a href="/metodo/">Come sono calcolati i numeri</a>.
        </p>
      </div>
    </footer>

    <script>
      // Porta in vista la sezione corrente quando la barra scorre in orizzontale (schermi stretti).
      document.querySelector('nav.sections a[aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 8px;
    top: 8px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
  }
  .masthead {
    padding-top: 14px;
  }
  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .nameplate {
    display: block;
    padding: 18px 0 14px;
    font-size: clamp(2.6rem, 9vw, 6.2rem);
    text-decoration: none;
    color: var(--ink);
  }
  .nameplate em {
    font-style: italic;
    color: var(--accent);
  }
  .compact .nameplate {
    padding: 10px 0 8px;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
  }

  .sections {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--nav-height);
    background: var(--ink);
    color: var(--paper);
  }
  .sections .wrap {
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    /* la sfumatura a destra segnala che l'elenco continua oltre il bordo */
    mask-image: linear-gradient(to right, #000 calc(100% - 36px), transparent);
  }
  ol {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0 36px 0 0;
    list-style: none;
  }
  .sections li {
    display: flex;
  }
  .sections a {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 12px;
    font-family: var(--font-data);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--paper);
    transition: background 0.15s;
  }
  .sections a:hover {
    background: rgb(245 240 230 / 0.14);
    color: var(--paper);
  }
  .sections a[aria-current='page'] {
    background: var(--accent);
    color: #fff;
  }
  .sections a:focus-visible {
    outline-color: var(--paper);
    outline-offset: -3px;
  }
  .num {
    font-size: 0.62rem;
    opacity: 0.6;
  }
  main {
    padding-block: 28px 56px;
  }
  .foot {
    padding: 22px 0 48px;
    font-size: 0.86rem;
    color: var(--ink-2);
  }
  .foot ul {
    margin: 8px 0 14px;
    padding: 0;
    list-style: none;
  }
  .foot li {
    padding: 2px 0;
  }
  .small {
    max-width: var(--measure);
  }
</style>
