---
import { neighbours, sectionNumber, type Section } from '../lib/sections';

interface Props {
  section: Section;
}

const { previous, next } = neighbours(Astro.props.section.id);
---

<nav class="pager double-rule" aria-label="Sezione precedente e successiva">
  {
    previous ? (
      <a class="previous" href={previous.href} data-keep-filters>
        <span class="kicker">← {sectionNumber(previous.id)} · Precedente</span>
        <span class="headline">{previous.label}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a class="next" href={next.href} data-keep-filters>
        <span class="kicker">Continua · {sectionNumber(next.id)} →</span>
        <span class="headline">{next.label}</span>
        <span class="blurb">{next.blurb}</span>
      </a>
    )
  }
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 24px;
    margin-top: 64px;
    padding-top: 18px;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 0 10px;
    text-decoration: none;
  }
  .next {
    align-items: flex-end;
    text-align: right;
  }
  .headline {
    font-size: clamp(1.3rem, 3vw, 2.1rem);
  }
  .previous .headline {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--ink-2);
  }
  .blurb {
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  a:hover .headline {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
  }
</style>
